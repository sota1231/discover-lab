# ConoHa WING（Apache / LiteSpeed）向け設定
# ビルド時に dist/ 直下へコピーされます。

DirectoryIndex index.html

# --- HTTPS へ統一（独自ドメインの SSL 設定後に有効化してください） ---
# <IfModule mod_rewrite.c>
#   RewriteEngine On
#   RewriteCond %{HTTPS} off
#   RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]
# </IfModule>

# --- www なしへ統一する場合（example.com を実ドメインに置き換え） ---
# <IfModule mod_rewrite.c>
#   RewriteEngine On
#   RewriteCond %{HTTP_HOST} ^www\.example\.com$ [NC]
#   RewriteRule ^(.*)$ https://example.com/$1 [R=301,L]
# </IfModule>

# --- 圧縮 ---
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json application/xml image/svg+xml
</IfModule>

# --- キャッシュ ---
# assets/ 配下はファイル名にハッシュが付くため長期キャッシュ、index.html は常に再検証
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2|svg|png|jpg|jpeg|webp|avif)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "^(index\.html|favicon\.svg|og-image\.jpg|apple-touch-icon\.png|robots\.txt|sitemap\.xml)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>

  # セキュリティヘッダー
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

# 隠しファイルへのアクセスを拒否（.htaccess 自体など）
<FilesMatch "^\.">
  Require all denied
</FilesMatch>

ErrorDocument 404 /index.html
